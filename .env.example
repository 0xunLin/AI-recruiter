# Database (point DATABASE_URL to PgBouncer on port 6432 in production/Docker, or Postgres 5432 locally)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/recruiter_db
DIRECT_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/recruiter_db

# Redis (Broker, Result Backend, and Global Token Bucket Rate Limiter)
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_BACKEND_URL=redis://localhost:6379/1
REDIS_RATE_LIMIT_URL=redis://localhost:6379/2

# AI Providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIM=1024

# Global Rate Limits (Redis Token Bucket across all Celery workers)
LLM_RPM_LIMIT=30
LLM_TPM_LIMIT=60000
EMBEDDING_RPM_LIMIT=60
EMBEDDING_TPM_LIMIT=100000

# Security & App
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
AUTH_SECRET=change-this-to-a-random-64-char-secret-in-production
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_REPO_FILES=500
MAX_FILE_BYTES=262144
MAX_REPOS_PER_RESUME=6

# Recruiter Auth (Google OAuth + Magic Link SMTP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ai-recruiter.local

# Applicant Auth (GitHub OAuth only)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
